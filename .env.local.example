# Self-contained local demo: copy to .env.local, then follow README.md.
# Start Postgres with npm run db:local:up; migrate/seed with npm run db:local:setup.
DATABASE_URL="postgresql://init:init_local@127.0.0.1:55432/init_member_hub"
NEXTAUTH_URL="http://localhost:3000"
# Replace with a generated value: openssl rand -base64 32
NEXTAUTH_SECRET="local-development-only-change-this-secret"

# Test accounts require npm run dev, loopback DB/app URLs, and no Vercel environment.
LOCAL_DEV_AUTH="true"

# Optional: set LOCAL_DEV_AUTH=false and configure these to test real LinkedIn login.
# Bootstrap admin emails must match a verified LinkedIn email; comma-separated.
BOOTSTRAP_ADMIN_EMAILS=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Optional PUBLIC Vercel Blob store for photos/covers (no local image-upload fallback).
BLOB_READ_WRITE_TOKEN=""
# Leave empty for private local CV files in .local/member-cvs/.
# To test hosted CV storage instead, use a separate PRIVATE Blob store token.
CV_BLOB_READ_WRITE_TOKEN=""

# Optional email delivery. Leave the key empty to log email attempts locally.
RESEND_API_KEY=""
EMAIL_FROM="IN-IT Community <onboarding@resend.dev>"
