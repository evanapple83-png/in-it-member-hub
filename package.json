{
  "name": "in-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "psql \"$DATABASE_URL\" -f drizzle/seed.sql",
    "db:local:up": "docker compose up -d --wait",
    "db:local:down": "docker compose stop",
    "db:local:setup": "node scripts/local-db.mjs",
    "test:local-auth": "node --experimental-strip-types --test tests/local-dev-auth.test.mjs"
  },
