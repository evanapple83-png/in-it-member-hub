# Hosted development/deployment template. For the self-contained local demo,
# copy .env.local.example to .env.local instead. Never commit real credentials.

# Neon Postgres connection string. Apply numbered drizzle/*.sql migrations.
DATABASE_URL="postgresql://user:password@your-neon-host/db?sslmode=require"

# Use your HTTPS origin in deployment. Generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Local test accounts are disabled for hosted environments.
LOCAL_DEV_AUTH="false"
# Comma-separated verified LinkedIn emails; sign-in bootstraps the admin row.
BOOTSTRAP_ADMIN_EMAILS=""

# LinkedIn OpenID Connect; callback: <NEXTAUTH_URL>/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# PUBLIC Vercel Blob store: profile photos and community covers.
BLOB_READ_WRITE_TOKEN=""
# Separate PRIVATE Vercel Blob store: PDF CVs. Required for hosted CV storage.
# Do not reuse the public image store token.
CV_BLOB_READ_WRITE_TOKEN=""

# Optional email delivery. Without the API key, email attempts are logged.
RESEND_API_KEY=""
# Replace with a sender configured in Resend for deployment.
EMAIL_FROM="IN-IT Community <onboarding@resend.dev>"
